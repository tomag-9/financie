generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                      String                   @id @default(cuid())
  name                    String
  type                    AccountType
  currency                String                   @default("EUR")
  isActive                Boolean                  @default(true)
  sortOrder               Int                      @default(0)
  trackingStartMonth      DateTime?
  closedAt                DateTime?
  snapshots               Snapshot[]
  investmentContributions InvestmentContribution[]
  createdAt               DateTime                 @default(now())
}

model Snapshot {
  id           String                @id @default(cuid())
  accountId    String
  account      Account               @relation(fields: [accountId], references: [id])
  month        DateTime
  balance      Decimal?
  note         String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  customValues SnapshotCustomValue[]

  @@unique([accountId, month])
}

model IncomeSource {
  id       String        @id @default(cuid())
  name     String
  color    String        @default("#378ADD")
  isActive Boolean       @default(true)
  entries  IncomeEntry[]
}

model IncomeEntry {
  id       String       @id @default(cuid())
  sourceId String
  source   IncomeSource @relation(fields: [sourceId], references: [id])
  month    DateTime
  amount   Decimal
  note     String?

  @@unique([sourceId, month])
}

model JojDetail {
  id            String   @id @default(cuid())
  month         DateTime @unique
  streamCount   Int      @default(0)
  ratePerStream Decimal  @default(0)
  tvHonorar     Decimal  @default(0)
  bonus         Decimal  @default(0)
  expectedTotal Decimal
  receivedTotal Decimal?
  diff          Decimal?
}

model Liability {
  id          String    @id @default(cuid())
  name        String
  totalAmount Decimal
  remaining   Decimal
  dueDate     DateTime?
  category    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Investment {
  id         String            @id @default(cuid())
  ticker     String
  isin       String?
  name       String
  platform   String
  isArchived Boolean           @default(false)
  assetType  String            @default("ETF")
  units      Decimal           @default(0)
  avgPrice   Decimal?
  entries    InvestmentEntry[]

  @@unique([ticker, platform, isArchived])
}

model InvestmentEntry {
  id           String     @id @default(cuid())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id])
  month        DateTime
  entryType    String     @default("RECURRING")
  unitsAdded   Decimal    @default(0)
  amountAdded  Decimal    @default(0)
  priceAtTime  Decimal?

  @@unique([investmentId, month])
}

// Monthly cash invested through an account. This is intentionally separate
// from portfolio positions/trades stored in Investment and InvestmentEntry.
model InvestmentContribution {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  month     DateTime
  mode      String   @default("RECURRING")
  amount    Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, month])
  @@index([month])
}

model CustomField {
  id         String                @id @default(cuid())
  entityType String
  label      String
  fieldType  CustomFieldType
  sortOrder  Int                   @default(0)
  isActive   Boolean               @default(true)
  values     SnapshotCustomValue[]
}

model SnapshotCustomValue {
  id         String      @id @default(cuid())
  snapshotId String
  snapshot   Snapshot    @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  fieldId    String
  field      CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value      Json

  @@unique([snapshotId, fieldId])
  @@index([fieldId])
}

model Settings {
  id   String @id @default("singleton")
  data Json
}

model AppLog {
  id        String   @id @default(cuid())
  source    String
  level     String
  message   String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([level, createdAt])
}

model AiAlarm {
  id              String    @id @default(cuid())
  label           String?
  time            String
  date            DateTime?
  days            String?
  isRepeat        Boolean   @default(false)
  isEnabled       Boolean   @default(true)
  runClaude       Boolean   @default(true)
  runCodex        Boolean   @default(false)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  runs            AiAlarmRun[]

  @@index([isEnabled, time])
}

model AiAlarmRun {
  id           String    @id @default(cuid())
  alarmId      String?
  alarm        AiAlarm?  @relation(fields: [alarmId], references: [id], onDelete: SetNull)
  alarmLabel   String?
  trigger      String
  status       String
  targets      String
  output       Json?
  error        String?
  scheduledFor DateTime?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@unique([alarmId, scheduledFor, trigger])
  @@index([startedAt])
  @@index([status, startedAt])
}

enum AccountType {
  BANK
  INVESTMENT
  CASH
  PENSION
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
}
