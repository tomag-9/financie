AUTH_SECRET=replace_with_generated_secret
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL="file:./financie.db"
ADMIN_PASSWORD=change_me_strong_password
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_EMAIL=mailto:tomas@example.com
ALPHA_VANTAGE_KEY=
ENABLE_CRON=true
DEFAULT_SAVINGS_TARGET=20
PROXMOX_URL=https://192.168.1.10:8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=financie@pve!financie
PROXMOX_TOKEN_SECRET=replace_with_proxmox_api_token_secret
PROXMOX_ALLOWED_CTS=101,103
# Nastav na false iba pri self-signed certifikáte na dôveryhodnej lokálnej sieti.
PROXMOX_TLS_REJECT_UNAUTHORIZED=true
